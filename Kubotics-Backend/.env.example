# ==============================================================================
# Kubotics Backend Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# (Change these to match your local or AWS RDS PostgreSQL credentials)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=kubotics

# ------------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------------------------
# Voice AI Keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ------------------------------------------------------------------------------
# Microsoft 365 Tenant (Optional for local testing)
# ------------------------------------------------------------------------------
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_ORGANIZER_EMAIL=vincent@kubotics.ch

# ------------------------------------------------------------------------------
# Kubot mail agent (docs/KUBOT_MAIL_AGENT_PLAN.md §6/§7.3) — non-secret config.
# LLM keys arrive as GitHub secrets: MIMO_API_KEY (platform.xiaomimimo.com),
# XAI_API_KEY (console.x.ai), plus existing OPENAI_API_KEY / GEMINI_API_KEY.
# The provider chain skips providers whose key/model is missing.
# ------------------------------------------------------------------------------
MAIL_AGENT_ENABLED=false
MAIL_AGENT_MODE=auto
MAIL_AGENT_POLL_INTERVAL_S=60
MAIL_AGENT_UPN=
MAIL_AGENT_REPLY_WINDOW_DAYS=7
MAIL_AGENT_UNKNOWN_POLICY=auto
MAIL_AGENT_LANGUAGES=de-CH,en,fr,it,nl
MAIL_AGENT_OWN_ADDRESSES=
MAIL_AGENT_LLM_CHAIN=mimo,openai,gemini,xai
MAIL_AGENT_LLM_MODEL_MIMO=mimo-v2.6-flash
MAIL_AGENT_LLM_MODEL_OPENAI=
MAIL_AGENT_LLM_MODEL_GEMINI=
MAIL_AGENT_LLM_MODEL_XAI=
MAIL_AGENT_LLM_BASE_MIMO=https://api.xiaomimimo.com/v1
MAIL_AGENT_TIER_MAP=Board=board;VIP=vip_customer;Kunde=customer;Partner=partner;Lead=lead;Test=test
MAIL_AGENT_ONLY_SENDERS=
MAIL_AGENT_MAX_REPLIES_PER_DAY=20
MAIL_AGENT_CONVERSATION_COOLDOWN_H=24
MAIL_AGENT_SPAM_THRESHOLD=0.80
MAIL_AGENT_NOTIFY_PHONE=+41797481975
MAIL_AGENT_ALERT_WINDOW_START=07:30
MAIL_AGENT_ALERT_WINDOW_END=22:00
MAIL_AGENT_ALERT_TZ=Europe/Zurich
