{
  "family": "kubotics-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ECSTasks",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ECSTasks",
  "containerDefinitions": [
    {
      "name": "kubotics-backend",
      "image": "ACCOUNT_ID.dkr.ecr.eu-central-1.amazonaws.com/kubotics-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "DEBUG", "value": "false" },
        { "name": "POSTGRES_SCHEMA", "value": "crm" },
        { "name": "AZURE_TENANT_ID", "value": "aef12348-a49b-42b9-93e5-b8d23baaa54c" },
        { "name": "AZURE_CLIENT_ID", "value": "7246abc4-b1d9-47d7-b8be-2e791de2f407" },
        { "name": "M365_ORGANIZER_EMAIL", "value": "vincent.verbeke@kuroliv.ch" },
        { "name": "M365_DEFAULT_TIMEZONE", "value": "Europe/Zurich" },
        { "name": "NEEDLE_OPERATOR_SENDERS", "value": "+41797481975" },
        { "name": "NEEDLE_TOKEN", "value": "n3-local-dev-token" },
        { "name": "ELEVENLABS_VOICE_ID", "value": "21m00Tcm4TlvDq8ikWAM" },
        { "name": "ELEVENLABS_MODEL_ID", "value": "eleven_turbo_v2_5" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/kubotics-backend",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
